.venv/
__pycache__/
*.pyc
.env
data/raw/
data/processed/
.DS_Store
.pytest_cache/
~$*.docx

# Trained artifacts are regenerable with `python -m forecasting.train <region>`.
# The measured evidence stays tracked; models, scalers and caches do not.
# Filenames are region-suffixed since Phase 1.2, hence the globs.
models/*
!models/metrics_*.json
!models/test_forecast_plot_*.png
!models/training_history_*.json
!models/region_comparison.md
# Phase 1.3 ablation evidence (already matched by the globs above; spelled out
# so the intent survives any future narrowing of them).
!models/metrics_ridge_*.json
!models/metrics_lstm_small_*.json
!models/training_history_lstm_small_*.json
# Phase 1.4 robustness evidence
!models/rolling_window_check.json
!models/metrics_t1_ridge.json
# Phase 1.5 horizon evidence (the manifest is what the tool reads at runtime)
!models/horizon_comparison.json
!models/horizon_manifest.json
# Phase 1.6 IOD evidence (the DMI cache itself is regenerable, so ignored)
!models/iod_comparison.json
# Heat Stress agent evidence
!models/heat_metrics_*.json
!models/heat_region_comparison.md
!models/heat_manifest.json
!models/heat_phase11.json

# --- Phase 2: Retrieval Agent -------------------------------------------------
# The Chroma index and downloaded source bytes are regenerable from the manifest
# with `python -m retrieval.build`; the manifest and eval results are the record
# and stay tracked.
retrieval/chroma_store/
retrieval/cache/
retrieval/chunks.jsonl

# --- Phase 3: Orchestrator ----------------------------------------------------
# The failure log is a runtime artifact and grows per query. The curated sample
# of what the checker actually caught during testing IS kept — it is a real
# result, like the Phase-1.4 leak and the Heat-1.1 baseline bug.
orchestrator/grounding_failures.jsonl

# internal working docs (project log, phase specs, tech spec, audit report,
# old README draft) - not part of the public repo, kept locally only
internal_docs/
