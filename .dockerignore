# Mirrors .gitignore: derived data is rebuilt inside the image, not copied in.
.venv/
.git/
.github/
__pycache__/
*.pyc
.pytest_cache/
.env

# Regenerable during `docker build` via scripts.setup
data/raw/
data/processed/
retrieval/chroma_store/
retrieval/cache/
retrieval/chunks.jsonl
*.joblib
*.keras
*.parquet
*.png

# Not needed to run the API
*.docx
~$*
**/CLAUDE*.md
# the design-tool prototype; frontend/ is the real thing
design_export/
orchestrator/grounding_failures.jsonl

# Private working notes and phase specs. EVALUATION.md and PROJECT_LOG.md are
# deliberately NOT listed: /evaluation serves the first and the retrieval corpus
# indexes the second, so an image built from the author's checkout needs both.
internal_docs/
